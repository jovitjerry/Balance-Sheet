MONGODB_URI=
MONGODB_DB=balancesheet
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=26214400
ALLOWED_EXTENSIONS=.pdf,.xlsx
EQUATION_TOLERANCE_ABS=1
EQUATION_TOLERANCE_REL=0.005
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_CHARS_PER_PAGE=20
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_S=120
OLLAMA_NUM_CTX=4096
LLM_REQUIRED=false
NORMALIZATION_CONFIDENCE_FLOOR=0.5
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_S=60
STORAGE_BACKEND=local
STORAGE_DIR=var/uploads
MAX_PRELIM_INLINE_BYTES=8388608
