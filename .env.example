# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.
#
# Only MONGODB_URI is required. Every other key is commented out and shows the
# built-in default; uncomment a line only to override it. (An uncommented key
# with an empty value is a validation error, not "use the default".)

# ---- MongoDB Atlas (REQUIRED) ----
# mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=

# ---- MongoDB (optional) ----
#MONGODB_DB=balancesheet

# ---- API (optional) ----
# Comma-separated CORS origins for the Vite dev server.
#ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads (optional) ----
#MAX_UPLOAD_BYTES=26214400
# .xlsx only - the legacy .xls binary format is out of scope.
#ALLOWED_EXTENSIONS=.pdf,.xlsx

# ---- Accounting equation (optional) ----
# Total Assets = Total Liabilities + Shareholders' Equity
# Effective threshold is max(ABS, REL * |total_assets|).
#EQUATION_TOLERANCE_ABS=1
#EQUATION_TOLERANCE_REL=0.005

# ---- OCR (optional) ----
# Requires the Tesseract SYSTEM BINARY, not just the pytesseract pip package.
# Set OCR_ENABLED=false to refuse scanned documents instead of reading them.
#OCR_ENABLED=true
#OCR_LANGUAGE=eng
#OCR_DPI=300
# A PDF page with fewer extractable characters than this is treated as scanned.
#OCR_MIN_CHARS_PER_PAGE=20

# ---- Module 2: local LLM via Ollama (optional) ----
# Terminology normalization runs on a LOCAL model through Ollama. Ollama is a
# SYSTEM INSTALL with a model pulled - the pip side of this project talks to it
# over HTTP and cannot supply it. See README.
#
# Nothing here is required to run the application. With Ollama stopped, every
# line item is still extracted with its figure, section and source; labels that
# are not the canonical wording are marked needs_review instead of guessed at.
#OLLAMA_HOST=http://localhost:11434
# Which model decides terminology (Module 2). Selected 2026-08-26 by
# measurement: 97% accuracy over 75 labelled cases, clean output, 4.15s warm per
# label, 6.4 GB on an 8 GB card. Evidence and known limitations:
# backend/benchmarks/results/MODEL_SELECTION.md
#
# Module 4 will use the same provider with different prompts and must pick its
# own model on its own evidence - this figure measured terminology mapping only.
# Tags must match `ollama list` exactly, including any quantisation suffix.
#OLLAMA_MODEL=qwen3:8b
#OLLAMA_TIMEOUT_S=120
# The KV cache grows with the context window and 8 GB of VRAM is the binding
# constraint on a laptop GPU. One label at a time needs nothing longer.
#OLLAMA_NUM_CTX=4096
# Set true to refuse extraction outright when the model is unreachable, rather
# than degrading to needs_review. Use in CI and for a demo, where a quietly
# un-normalized document would be a false green.
#LLM_REQUIRED=false
# Below this stated confidence a mapping is recorded but marked needs_review.
# A policy floor, NOT a calibrated probability - it can demote a mapping and
# can never rescue one that failed validation.
#NORMALIZATION_CONFIDENCE_FLOOR=0.5

# ---- File storage (optional) ----
# Where original uploaded files are kept. Currently only "local".
#STORAGE_BACKEND=local
#STORAGE_DIR=var/uploads

# ---- Preliminary extraction (optional) ----
# Preliminary extraction payloads larger than this (bytes) are offloaded to
# file storage instead of being stored inline in the MongoDB document.
#MAX_PRELIM_INLINE_BYTES=8388608
