# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.
#
# Only MONGODB_URI is required. Every other key is commented out and shows the
# built-in default; uncomment a line only to override it. (An uncommented key
# with an empty value is a validation error, not "use the default".)

# ---- MongoDB Atlas (REQUIRED) ----
# mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=

# ---- MongoDB (optional) ----
#MONGODB_DB=balancesheet

# ---- API (optional) ----
# Comma-separated CORS origins for the Vite dev server.
#ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads (optional) ----
#MAX_UPLOAD_BYTES=26214400
#ALLOWED_EXTENSIONS=.pdf,.xlsx,.xls

# ---- Accounting equation (optional) ----
# Total Assets = Total Liabilities + Shareholders' Equity
# Effective threshold is max(ABS, REL * |total_assets|).
#EQUATION_TOLERANCE_ABS=1
#EQUATION_TOLERANCE_REL=0.005

# ---- File storage (optional) ----
# Where original uploaded files are kept. Currently only "local".
#STORAGE_BACKEND=local
#STORAGE_DIR=var/uploads

# ---- Preliminary extraction (optional) ----
# Preliminary extraction payloads larger than this (bytes) are offloaded to
# file storage instead of being stored inline in the MongoDB document.
#MAX_PRELIM_INLINE_BYTES=8388608
